# ── PLAYORA — environment ──
# Copy to .env.local for local development (.env.local is gitignored), and
# set the same keys in your host's dashboard
# (Vercel: Project → Settings → Environment Variables).

# Public base URL of the deployment. Drives canonical URLs, the sitemap,
# robots.txt and Open Graph image URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Admin sign-in for the preview build.
#
# These are NEXT_PUBLIC_*, so they are compiled into the JavaScript bundle
# and readable by anyone who opens devtools. They keep credentials out of
# the git history — they do not make the console secure. Real protection
# needs the Django auth endpoint; until then treat the admin panel as a
# demo, and never reuse a password you use anywhere else.
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# Django REST backend, once it exists.
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
