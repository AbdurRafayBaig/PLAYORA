# ── PLAYORA — environment ──
# Copy to .env.local for local development, and set the same keys in your
# host's dashboard (Vercel: Project → Settings → Environment Variables).

# Public base URL of the deployment. Drives canonical URLs, the sitemap,
# robots.txt and Open Graph image URLs. No trailing slash.
# Leave unset locally; it falls back to https://playora.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Django REST backend, once it exists. Unused while the app runs on the
# bundled demo dataset in src/lib/data.ts.
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
